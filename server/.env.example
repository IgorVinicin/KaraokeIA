# Only on the server. Never copy this credential into app/.env or Gradle.
YOUTUBE_API_KEY=
HOST=127.0.0.1
PORT=8080
# Single process; cache and counters are in memory, reset on restart.
MAX_UPSTREAM_SEARCHES_PER_DAY=80
REQUESTS_PER_IP_PER_MINUTE=20
# Enable only behind a proxy that overwrites X-Forwarded-For and blocks direct access.
TRUST_PROXY=false
